{
  "name": "Lembrete dos prazos",
  "description": "No dashboard de cada membro, crie um banner de lembrete dos pro\u00f3ximos prazos",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update",
        "delete"
      ],
      "entity_name": "Demand"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "lembrete_dos_prazos",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "remindUpcomingDeadlines",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "remindUpcomingDeadlines"
  }
}