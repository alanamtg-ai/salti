{
  "name": "Demand",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "post_feed",
        "post_stories",
        "post_reels",
        "carrossel",
        "banner_digital",
        "banner_impresso",
        "flyer",
        "infografico",
        "logo",
        "identidade_visual",
        "papelaria",
        "embalagem",
        "video_curto",
        "video_longo",
        "motion_graphics",
        "animacao",
        "copy_legenda",
        "copy_email",
        "copy_blog",
        "copy_anuncio",
        "landing_page",
        "website",
        "ecommerce",
        "planejamento_estrategico",
        "relatorio",
        "apresentacao",
        "roteiro",
        "pauta_editorial",
        "briefing",
        "foto_produto",
        "foto_editorial",
        "outro"
      ],
      "description": "Tipo de produto/servi\u00e7o"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media"
    },
    "current_step": {
      "type": "string",
      "enum": [
        "briefing",
        "estrategia",
        "redacao",
        "design",
        "aprovacao_cliente",
        "distribuicao",
        "finalizado"
      ],
      "description": "Etapa atual da demanda"
    },
    "steps_flow": {
      "type": "array",
      "description": "Sequ\u00eancia de etapas definida na cria\u00e7\u00e3o",
      "items": {
        "type": "string"
      }
    },
    "current_step_index": {
      "type": "number",
      "default": 0
    },
    "distribuicao_tipo": {
      "type": "string",
      "enum": [
        "social_media",
        "midia",
        "finalizar"
      ],
      "description": "Decis\u00e3o de destino p\u00f3s aprova\u00e7\u00e3o do cliente"
    },
    "assignees": {
      "type": "object",
      "description": "Mapa de etapa -> user_email respons\u00e1vel",
      "properties": {
        "estrategia": {
          "type": "string"
        },
        "redacao": {
          "type": "string"
        },
        "design": {
          "type": "string"
        },
        "aprovacao_cliente": {
          "type": "string"
        },
        "distribuicao": {
          "type": "string"
        }
      }
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "step_deadlines": {
      "type": "object",
      "description": "Prazo por etapa",
      "properties": {
        "estrategia": {
          "type": "string"
        },
        "redacao": {
          "type": "string"
        },
        "design": {
          "type": "string"
        },
        "aprovacao_cliente": {
          "type": "string"
        },
        "distribuicao": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "finalizado",
        "cancelado"
      ],
      "default": "ativo"
    },
    "rejection_note": {
      "type": "string"
    },
    "time_spent": {
      "type": "number",
      "description": "Tempo total gasto em minutos"
    },
    "time_logs": {
      "type": "array",
      "description": "Registro de tempo por colaborador/etapa",
      "items": {
        "type": "object",
        "properties": {
          "by": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "minutes": {
            "type": "number"
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "step_started_at": {
      "type": "string",
      "description": "ISO datetime em que a etapa atual come\u00e7ou"
    },
    "sketch_data": {
      "type": "string",
      "description": "URL da imagem do canvas de briefing"
    },
    "reference_links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Links de refer\u00eancia"
    },
    "content_cards": {
      "type": "array",
      "description": "Cards de conte\u00fado criados na etapa de estrat\u00e9gia para envio ao redator",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "data_postagem": {
            "type": "string"
          },
          "dia_semana": {
            "type": "string"
          },
          "tipo_conteudo": {
            "type": "string"
          },
          "canais": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "horario": {
            "type": "string"
          },
          "tema": {
            "type": "string"
          },
          "observacoes": {
            "type": "string"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "description": "Hist\u00f3rico de movimenta\u00e7\u00f5es",
      "items": {
        "type": "object",
        "properties": {
          "etapa_origem": {
            "type": "string"
          },
          "etapa_destino": {
            "type": "string"
          },
          "acao": {
            "type": "string",
            "enum": [
              "aprovado",
              "revisou",
              "reprovou",
              "criado"
            ]
          },
          "by": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      }
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scheduled_date": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "client_id"
  ],
  "rls": {
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}