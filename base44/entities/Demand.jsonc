{
  "name": "Demand",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "social_media",
        "video",
        "design",
        "copy",
        "website",
        "estrategia",
        "outro"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media"
    },
    "current_step": {
      "type": "string"
    },
    "steps_flow": {
      "type": "array",
      "description": "Sequ\u00eancia de etapas definida na cria\u00e7\u00e3o",
      "items": {
        "type": "string"
      }
    },
    "current_step_index": {
      "type": "number",
      "default": 0
    },
    "assignees": {
      "type": "object",
      "description": "Mapa de etapa -> user_email respons\u00e1vel",
      "properties": {
        "redator": {
          "type": "string"
        },
        "designer": {
          "type": "string"
        },
        "social_media": {
          "type": "string"
        },
        "aprovacao_interna": {
          "type": "string"
        },
        "aprovacao_cliente": {
          "type": "string"
        }
      }
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "step_deadlines": {
      "type": "object",
      "description": "Prazo por etapa",
      "properties": {
        "redator": {
          "type": "string"
        },
        "designer": {
          "type": "string"
        },
        "aprovacao_interna": {
          "type": "string"
        },
        "aprovacao_cliente": {
          "type": "string"
        },
        "social_media": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "aprovado_cliente",
        "publicado",
        "cancelado"
      ],
      "default": "ativo"
    },
    "rejection_note": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "description": "Hist\u00f3rico de movimenta\u00e7\u00f5es",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scheduled_date": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "client_id"
  ],
  "rls": {
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}