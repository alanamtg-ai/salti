{
  "name": "Demand",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "post_feed",
        "post_stories",
        "post_reels",
        "carrossel",
        "banner_digital",
        "banner_impresso",
        "flyer",
        "infografico",
        "logo",
        "identidade_visual",
        "papelaria",
        "embalagem",
        "video_curto",
        "video_longo",
        "motion_graphics",
        "animacao",
        "copy_legenda",
        "copy_email",
        "copy_blog",
        "copy_anuncio",
        "landing_page",
        "website",
        "ecommerce",
        "planejamento_estrategico",
        "relatorio",
        "apresentacao",
        "roteiro",
        "pauta_editorial",
        "foto_produto",
        "foto_editorial",
        "outro"
      ],
      "description": "Tipo de produto/servi\u00e7o"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media"
    },
    "current_step": {
      "type": "string",
      "enum": [
        "estrategia",
        "redacao",
        "design",
        "aprovacao_cliente",
        "distribuicao",
        "trafego_pago",
        "finalizado"
      ],
      "default": "estrategia",
      "description": "Etapa atual da demanda"
    },
    "current_step_index": {
      "type": "number",
      "default": 0
    },
    "responsavel_atual_nome": {
      "type": "string",
      "description": "Nome do respons\u00e1vel atual"
    },
    "responsavel_atual_email": {
      "type": "string",
      "description": "Email do respons\u00e1vel atual"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "step_deadlines": {
      "type": "object",
      "description": "Prazo por etapa",
      "properties": {
        "estrategia": {
          "type": "string"
        },
        "redacao": {
          "type": "string"
        },
        "design": {
          "type": "string"
        },
        "aprovacao_cliente": {
          "type": "string"
        },
        "distribuicao": {
          "type": "string"
        },
        "trafego_pago": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "finalizado",
        "cancelado"
      ],
      "default": "ativo"
    },
    "rejection_note": {
      "type": "string",
      "description": "Nota da \u00faltima rejei\u00e7\u00e3o/revis\u00e3o"
    },
    "data_ultima_movimentacao": {
      "type": "string",
      "description": "Data da \u00faltima a\u00e7\u00e3o na demanda"
    },
    "step_started_at": {
      "type": "string",
      "description": "ISO datetime em que a etapa atual come\u00e7ou"
    },
    "sketch_data": {
      "type": "string",
      "description": "URL da imagem do canvas de briefing"
    },
    "reference_links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Links de refer\u00eancia"
    },
    "content_cards": {
      "type": "array",
      "description": "Cards de conte\u00fado criados na etapa de estrat\u00e9gia",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "data_postagem": {
            "type": "string"
          },
          "dia_semana": {
            "type": "string"
          },
          "tipo_conteudo": {
            "type": "string"
          },
          "canais": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "horario": {
            "type": "string"
          },
          "tema": {
            "type": "string"
          },
          "observacoes": {
            "type": "string"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "description": "Hist\u00f3rico de movimenta\u00e7\u00f5es",
      "items": {
        "type": "object",
        "properties": {
          "etapa_origem": {
            "type": "string"
          },
          "etapa_destino": {
            "type": "string"
          },
          "responsavel_origem_nome": {
            "type": "string"
          },
          "responsavel_origem_email": {
            "type": "string"
          },
          "responsavel_destino_nome": {
            "type": "string"
          },
          "responsavel_destino_email": {
            "type": "string"
          },
          "acao": {
            "type": "string",
            "enum": [
              "aprovou",
              "revisou",
              "reprovou",
              "criado"
            ]
          },
          "usuario_nome": {
            "type": "string"
          },
          "usuario_email": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scheduled_date": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "client_id"
  ]
}