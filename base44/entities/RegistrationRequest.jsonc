{
  "name": "RegistrationRequest",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email do solicitante"
    },
    "name": {
      "type": "string",
      "description": "Nome do solicitante"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "cliente",
        "equipe"
      ],
      "description": "Tipo definido pela gestora: cliente ou equipe"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fun\u00e7\u00f5es atribu\u00eddas (para equipe)"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente vinculado (para cliente)"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente vinculado"
    },
    "approved_by": {
      "type": "string",
      "description": "Email de quem aprovou"
    }
  },
  "required": [
    "email",
    "status"
  ]
}