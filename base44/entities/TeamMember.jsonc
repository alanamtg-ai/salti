{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "estrategista",
        "redator",
        "designer",
        "social_media",
        "gestor_trafego",
        "videomaker",
        "assistente_financeira",
        "midia",
        "cliente"
      ],
      "default": "redator"
    },
    "client_id": {
      "type": "string",
      "description": "Preenchido quando role=cliente"
    },
    "avatar_color": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL da foto de perfil"
    },
    "whatsapp": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "linkedin": {
      "type": "string"
    },
    "behance": {
      "type": "string"
    },
    "bio": {
      "type": "string",
      "description": "Mini bio"
    },
    "birthday": {
      "type": "string",
      "format": "date",
      "description": "Data de anivers\u00e1rio"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "light"
    }
  },
  "required": [
    "name",
    "email",
    "role"
  ]
}